{% liquid
  assign app_url = "https://cod-horn-hamilton-enterprises.trycloudflare.com"
  assign shop_domain = shop.permanent_domain
%}

<style>
  .eu-withdrawal-floating-root {
    width: 0;
    height: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: visible;
  }
</style>

<div
  class="eu-withdrawal-floating-root"
  data-app-url="{{ app_url | escape }}"
  data-shop-domain="{{ shop_domain | escape }}"
  data-locale="{{ request.locale.iso_code | default: 'en' | escape }}"
  data-button-label="{{ block.settings.button_label | escape }}"
  data-heading="{{ block.settings.heading | escape }}"
  data-position="{{ block.settings.position | escape }}"
  data-bottom-offset="{{ block.settings.bottom_offset }}"
  data-side-offset="{{ block.settings.side_offset }}"
  data-button-bg="{{ block.settings.button_bg | escape }}"
  data-button-text="{{ block.settings.button_text | escape }}"
></div>

<script
  src="{{ 'withdrawal-button.js' | asset_url }}"
  defer
></script>

{% schema %}
{
  "name": "Withdrawal sitewide btn",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "EU Withdrawal Request"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Modal heading",
      "default": "Submit EU Withdrawal Request"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Floating position",
      "default": "bottom-right",
      "options": [
        {
          "value": "bottom-right",
          "label": "Bottom right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        }
      ]
    },
    {
      "type": "range",
      "id": "bottom_offset",
      "label": "Bottom spacing",
      "min": 10,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "side_offset",
      "label": "Side spacing",
      "min": 10,
      "max": 140,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#0041c2"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}