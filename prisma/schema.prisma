generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shop {
  id                        String              @id @default(cuid())
  shopDomain                String              @unique
  shopHandle                String?
  accessToken               String?
  installedAt               DateTime            @default(now())
  uninstalledAt             DateTime?
  plan                      String              @default("BASIC")
  currentPlanHandle         String?
  currentSubscriptionId     String?
  currentSubscriptionStatus String?
  billingSyncedAt           DateTime?
  locale                    String              @default("en")
  brandingName              String?
  brandingPrimaryColor      String?
  merchantNotification      String?
  withdrawalDays            Int                 @default(14)
  legalPageUrl              String?
  privacyPageUrl            String?
  supportEmail              String?
  dpaAcceptedAt             DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  resolvedAt                DateTime?
  accessTokenExpiresAt      DateTime?
  refreshToken              String?
  refreshTokenExpiresAt     DateTime?
  tokenType                 String?             @default("NON_EXPIRING_OFFLINE")
  enabledLanguages          String              @default("[\"en\",\"de\"]")
  smtpEnabled               Boolean             @default(false)
  smtpFromEmail             String?
  smtpFromName              String?
  smtpHost                  String?
  smtpLastError             String?
  smtpPasswordEncrypted     String?
  smtpPort                  Int?
  smtpSecure                Boolean             @default(false)
  smtpUsername              String?
  smtpVerifiedAt            DateTime?
  emailDeliveryMethod       String              @default("GL6")
  resendDomainCreatedAt     DateTime?
  resendDomainId            String?
  resendDomainLastError     String?
  resendDomainName          String?
  resendDomainStatus        String?
  resendDomainVerifiedAt    DateTime?
  resendFromEmail           String?
  resendFromName            String?
  lastTokenRefreshAt        DateTime?
  tokenRefreshError         String?
  tokenStatus               String?             @default("ACTIVE")
  dataAccessAudits          DataAccessAudit[]
  emailTemplates            EmailTemplate[]
  requests                  WithdrawalRequest[]
}

model WithdrawalRequest {
  id                 String    @id @default(cuid())
  publicReference    String    @unique
  shopId             String
  orderNumber        String?
  orderId            String?
  customerEmail      String
  customerName       String?
  reason             String?
  status             String    @default("RECEIVED")
  source             String    @default("STOREFRONT")
  locale             String    @default("en")
  legalCopyVersion   String?
  metadataJson       String?
  submittedAt        DateTime  @default(now())
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  verificationStatus String    @default("UNVERIFIED")
  confirmationSentAt DateTime?
  emailProviderId    String?
  emailStatus        String    @default("PENDING")
  submissionKey      String?   @unique
  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
  @@index([shopId, orderId])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  shopId    String
  code      String
  subject   String
  bodyHtml  String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, code])
}

model DataAccessAudit {
  id          String   @id @default(cuid())
  shopId      String?
  action      String
  recordId    String?
  recordCount Int?
  actorType   String
  reason      String?
  createdAt   DateTime @default(now())
  shop        Shop?    @relation(fields: [shopId], references: [id])

  @@index([shopId, createdAt])
  @@index([action, createdAt])
}

model AbuseCounter {
  id            String   @id @default(cuid())
  category      String
  scope         String
  scopeKey      String
  windowStart   DateTime
  windowSeconds Int
  count         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([category, scope, scopeKey, windowStart])
  @@index([category, updatedAt])
}

model AbuseConcurrencyLease {
  id        String   @id @default(cuid())
  category  String
  shopKey   String?
  provider  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([category, expiresAt])
  @@index([category, shopKey, expiresAt])
  @@index([category, provider, expiresAt])
}

model EmailDeliveryDecision {
  id                  String   @id @default(cuid())
  withdrawalRequestId String?
  shopDomain          String?
  recipientHash       String?
  provider            String?
  status              String
  reason              String?
  createdAt           DateTime @default(now())

  @@index([withdrawalRequestId, createdAt])
  @@index([shopDomain, createdAt])
  @@index([status, createdAt])
}
